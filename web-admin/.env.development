# 开发环境：接口走同源 /api，由 Vite 中间件 mock（后端就绪后设 VITE_USE_MOCK=false 转发到 :8080）
VITE_API_BASE=/api
VITE_USE_MOCK=true
# P0 后端仅提供 bearer 方言时用 sessionStorage 兜底 Access Token（联调后改回 memory，改由 httpOnly Cookie 承载 refresh）
# 取值：memory（正式口径，Access Token 仅内存）| session（P0 联调兜底）
VITE_ACCESS_TOKEN_STORAGE=session
VITE_APP_TITLE=电商平台管理端
